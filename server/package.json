{
  "name": "yojanamitra-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx prisma/create-admin.ts",
    "schemes:import": "tsx prisma/import-schemes.ts",
    "kb:ingest": "tsx scripts/kb-ingest.ts",
    "import:tracker": "tsx scripts/import-tracker.ts",
    "ai:test": "tsx scripts/ai-test.ts",
    "jobs:seed": "tsx prisma/seed-jobs.ts",
    "jobs:ingest": "tsx scripts/jobs-ingest.ts",
    "db:backup": "tsx scripts/db-maintenance.ts backup",
    "db:restore": "tsx scripts/db-maintenance.ts restore",
    "admin:reset-password": "tsx prisma/reset-password.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@yojanamitra/shared": "*",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.7.2",
    "prisma": "^6.16.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
