# Copy to .env. Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DATABASE_URL="file:../../data/app.db"
JWT_SECRET="replace-with-a-random-64-character-secret"
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
ADMIN_EMAIL=sastevinayak369@gmail.com
ADMIN_PASSWORD=Karma@369369

# Optional server-only AI providers. Leave blank to run offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenAI-compatible endpoint
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Optional web search grounding (Gemini only)
USE_WEB_SEARCH_GROUNDING=false

# Optional comma-separated official recruitment hosts for jobs:ingest
JOB_SOURCE_ALLOWLIST=

AI_PROVIDER_ORDER=Gemini,Groq,OpenAI-compatible,Ollama
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
TRUST_PROXY=false
CHAT_RETENTION_DAYS=90
BACKUP_DIR=../../data/backups
POSTGRES_ENABLED=false
