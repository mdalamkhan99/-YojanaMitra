NODE_ENV=production
DATABASE_URL="file:/var/lib/yojanamitra/app.db"
JWT_SECRET="replace-with-a-random-64-character-secret-generated-for-production"
CLIENT_ORIGIN="https://your-domain.example"
PORT=4000
TRUST_PROXY=true
CHAT_RETENTION_DAYS=90
BACKUP_DIR="/var/lib/yojanamitra/backups"
POSTGRES_ENABLED=false
